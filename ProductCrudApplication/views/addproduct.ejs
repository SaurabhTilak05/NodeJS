<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product</title>
</head>
<body>
    <%-include("home.ejs")%>
     <form action="/addProd" method="post">
        <div class="container p-5 bg-dark mt-5 " >
            
            <div class="form-group">
                <input type="text" name="name" id="" class="form-control control" value="" placeholder="Enter Name" />
            </div>
            <div class="form-group">
                <input type="text" name="category" id="" class="form-control control" value="" placeholder="Enter Category" />
            </div>
            <div class="form-group">
                <input type="text" name="price" id="" class="form-control control" value="" placeholder="Enter Price" />
            </div>

            <div class="form-group">
                <input type="text" name="quantity" id="" class="form-control control" value="" placeholder="Enter quantity" />
            </div>
            
            <div class="form-group">
                <input type="submit" name="" id="" class="form-control bg-primary" value="Add Product">
            </div>
              <%
        if(msg.length!=0){
        %>
        <div class="form-control btn-success">
                <%=msg%>
        </div>
         <%
        }
         %>
        </div>
    </form>

    
    
</body>
</html>