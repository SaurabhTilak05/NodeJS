<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product</title>
    <style>
        .cont{
            background-color: aqua;
            width: 700px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        #nm{
            width: 500px;
        }
        .wrp{
             
            display: flex;
            justify-content: center;
            align-items: center;
            
        }
    </style>
</head>
<body>
    <%-include("home.ejs")%>
    <div class="wrp">
     <form  id="fr" action="/addProd" method="post">
        <div class="cont mt-5 p-5" >
            
            <div class="form-group">
                <input type="text" name="name" id="nm" class="form-control control" value="" placeholder="Enter Name" />
            </div>
            <div class="form-group">
                <input type="text" name="category" id="nm" class="form-control control" value="" placeholder="Enter Category" />
            </div>
            <div class="form-group">
                <input type="text" name="price" id="nm" class="form-control control" value="" placeholder="Enter Price" />
            </div>

            <div class="form-group">
                <input type="text" name="quantity" id="nm" class="form-control control" value="" placeholder="Enter quantity" />
            </div>
            
            <div class="form-group">
                <input type="submit" name="" id="nm" class="form-control bg-primary" value="Add Product">
            </div>
              <%
        if(msg.length!=0){
        %>
        <div class="form-control btn-success">
                <%=msg%>
        </div>
         <%
        }
         %>
        </div>
    </form>

    </div>
    
</body>
</html>