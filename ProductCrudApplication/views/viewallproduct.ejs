<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Employee</title>
   <script type="text/javascript" src="ajax.js"> </script>
    
</head>
<body>
    <%- include("home.ejs")%>
    <div class="main">
    <div class="containe bg-dark p-5 mt-4">
        <div class="form-group ">
            <input type="text" name="name" value="" class="form-control" placeholder="search Food by Category" onkeyup="searchCategory(this.value)">
        </div>
        <table class="table table-striped table-secondary table-bordered">
        <tr>
            <th>SR No</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>DELETE</th>
            <th>UPDATE</th>
        </tr>
        <tbody id="tblBody">

        <%
            if(ProdList.length!=0){
                ProdList.forEach((row,index)=>{
        %>
            <tr>
                <td><%=index+1%></td>
                <td><%=row.name%></td>
                <td><%=row.category%></td>
                <td><%=row.price%></td>
                <td><%=row.quantity%></td>
                
                <td><a href="/deleteProd?id=<%=row.id%>" >DELETE</a></td>
                <td><a href="/updateProd?id=<%=row.id%>&pid=<%=row.name%>&category=<%=row.category%>&price=<%=row.price%>&quantity=<%=row.quantity%>" >UPDATE</a></td> 
            </tr>
        <%
                })
            }
            else{
        %>
            <td colspan="7"> Data not present !!</td>
        <%
            }
        %>
        </tbody>
    </table>

    </div>
    </div>

</body>
</html>